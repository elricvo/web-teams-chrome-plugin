{
  "manifest_version": 3,
  "name": "Teams Channel Archive — local",
  "version": "1.0.1",
  "description": "Archive locale de consultation du contenu rendu dans un canal Teams Web confirmé.",
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "action": {
    "default_title": "Archive Teams locale",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png"
    }
  },
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" }
}
